NODE_ENV=production
PORT=3000

URL={{ outline_url | to_json | replace('$', '$$') }}
APP_NAME={{ outline_app_name | to_json | replace('$', '$$') }}

SECRET_KEY={{ outline_secret_key }}
UTILS_SECRET={{ outline_utils_secret }}

DATABASE_URL=postgres://{{ outline_db_user }}:{{ outline_db_password }}@postgres:5432/{{ outline_db_name }}
REDIS_URL=redis://redis:6379

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

FORCE_HTTPS={{ (outline_url.startswith('https://')) | lower }}
PGSSLMODE=disable

SMTP_HOST={{ outline_smtp_host | to_json | replace('$', '$$') }}
SMTP_PORT={{ outline_smtp_port }}
SMTP_FROM_EMAIL={{ outline_smtp_from_email | to_json | replace('$', '$$') }}
SMTP_SECURE={{ outline_smtp_secure | lower }}
SMTP_USERNAME={{ outline_smtp_username | to_json | replace('$', '$$') }}
SMTP_PASSWORD={{ outline_smtp_password | to_json | replace('$', '$$') }}

{% if auth_mode == 'authentik' %}
# Outline discovers the remaining endpoints from the issuer.
OIDC_ISSUER_URL={{ authentik_external_url }}/application/o/{{ outline_oidc_slug }}/
OIDC_LOGOUT_URI={{ authentik_external_url }}/application/o/{{ outline_oidc_slug }}/end-session/
OIDC_CLIENT_ID={{ outline_oidc_client_id | to_json | replace('$', '$$') }}
OIDC_CLIENT_SECRET={{ outline_oidc_client_secret | to_json | replace('$', '$$') }}
{% else %}
# Cloudflare Access for SaaS (OIDC) is the identity provider; Google etc. sit behind it.
OIDC_ISSUER_URL={{ cloudflare_access_oidc_issuer_url }}
OIDC_CLIENT_ID={{ cloudflare_access_oidc_client_id | to_json | replace('$', '$$') }}
OIDC_CLIENT_SECRET={{ cloudflare_access_oidc_client_secret | to_json | replace('$', '$$') }}
{% endif %}
OIDC_USERNAME_CLAIM={{ outline_oidc_username_claim | to_json | replace('$', '$$') }}
OIDC_DISPLAY_NAME={{ outline_oidc_display_name | to_json | replace('$', '$$') }}
OIDC_SCOPES={{ outline_oidc_scopes | to_json | replace('$', '$$') }}
