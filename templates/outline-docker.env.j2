NODE_ENV=production
PORT=3000

URL={{ outline_url }}

SECRET_KEY={{ outline_secret_key }}
UTILS_SECRET={{ outline_utils_secret }}

DATABASE_URL=postgres://{{ outline_db_user }}:{{ outline_db_password }}@postgres:5432/{{ outline_db_name }}
REDIS_URL=redis://redis:6379

FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

FORCE_HTTPS=false
PGSSLMODE=disable

SMTP_HOST={{ outline_smtp_host }}
SMTP_PORT={{ outline_smtp_port }}
SMTP_FROM_EMAIL={{ outline_smtp_from_email }}
SMTP_SECURE={{ outline_smtp_secure | lower }}

OIDC_DISCOVERY_URL={{ authentik_external_url }}/application/o/{{ outline_oidc_slug }}/.well-known/openid-configuration
OIDC_ISSUER_URL={{ authentik_external_url }}/application/o/{{ outline_oidc_slug }}/
OIDC_CLIENT_ID={{ outline_oidc_client_id }}
OIDC_CLIENT_SECRET={{ outline_oidc_client_secret }}
OIDC_USERNAME_CLAIM={{ outline_oidc_username_claim }}
OIDC_DISPLAY_NAME={{ outline_oidc_display_name }}
OIDC_SCOPES={{ outline_oidc_scopes }}
