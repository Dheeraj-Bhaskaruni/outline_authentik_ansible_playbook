{
	admin off
	email {$ACME_EMAIL}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers {{ private_path_upstream_dns | join(' ') }}
	}
}

# Private path: these hostnames resolve to the Tailscale/LAN address of this
# host (dnsmasq), where Caddy terminates TLS with a real certificate obtained
# over DNS-01. Nothing here is reachable from the Internet.
{% for app in apps | selectattr('private') %}
{{ app.hostname }} {
	import cloudflare_tls
	import secure_headers
	reverse_proxy {{ app.upstream | regex_replace('^https?://', '') }}
}

{% endfor %}
