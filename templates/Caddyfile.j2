{
	admin off
	email {$ACME_EMAIL}
	servers {
		# cloudflared runs on the private edge network; keep its X-Forwarded-* headers.
		trusted_proxies static private_ranges
	}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

# Browser traffic arrives from cloudflared (after Cloudflare Access).
# The Outline container reaches the same hostname over the edge network alias,
# so OIDC discovery/token calls stay on this host and never cross Access.
{{ authentik_hostname }} {
	import cloudflare_tls
	import secure_headers
	reverse_proxy authentik-server:9000
}

{{ outline_hostname }} {
	import cloudflare_tls
	import secure_headers
	reverse_proxy outline:3000
}
