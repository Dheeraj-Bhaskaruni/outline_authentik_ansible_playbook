# Locally managed Cloudflare Tunnel. Every public hostname requires a valid
# Cloudflare Access JWT at the connector (browser session or service token),
# so a dashboard mistake cannot expose an origin. Unknown hostnames get 404.
tunnel: {{ cloudflare_tunnel_credentials_parsed.TunnelID | to_json }}
credentials-file: /etc/cloudflared/credentials.json
no-autoupdate: true
loglevel: info

ingress:
{% for app in apps %}
  - hostname: {{ app.hostname | to_json }}
    service: {{ app.upstream }}
    originRequest:
      access:
        required: true
        teamName: {{ cloudflare_access_team_name | to_json }}
        audTag:
{% for aud in app.access_auds %}
          - {{ aud | to_json }}
{% endfor %}
{% endfor %}
  - service: http_status:404
